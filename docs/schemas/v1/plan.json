{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://calendar-app.local/schemas/v1/plan.json",
  "title": "Calendar plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "state",
    "timezone",
    "targetDate",
    "bufferMinutes",
    "availability",
    "blocks",
    "unscheduled",
    "warnings"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "state": {
      "const": "proposal"
    },
    "timezone": {
      "type": "string",
      "format": "iana-timezone"
    },
    "targetDate": {
      "type": "string",
      "format": "calendar-date"
    },
    "bufferMinutes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1440
    },
    "availability": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "startsAt",
          "endsAt"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "\\S"
          },
          "startsAt": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "endsAt": {
            "type": "string",
            "pattern": "^(([01][0-9]|2[0-3]):[0-5][0-9]|24:00)$"
          }
        }
      }
    },
    "blocks": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "taskId",
          "estimateId",
          "startsAt",
          "endsAt",
          "effortMinutes",
          "rationale",
          "calendarType",
          "notifyMinutesBefore",
          "notificationFormat"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "\\S"
          },
          "taskId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "\\S"
          },
          "estimateId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "\\S"
          },
          "startsAt": {
            "type": "string",
            "format": "instant"
          },
          "endsAt": {
            "type": "string",
            "format": "instant"
          },
          "effortMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 525600
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S"
          },
          "calendarType": {
            "enum": [
              "personal",
              "study",
              "vacation",
              "holiday",
              "birthday",
              "other"
            ]
          },
          "notifyMinutesBefore": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10080
          },
          "notificationFormat": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          }
        }
      }
    },
    "unscheduled": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "taskId",
          "reason",
          "explanation"
        ],
        "properties": {
          "taskId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "\\S"
          },
          "reason": {
            "enum": [
              "unknown_estimate",
              "insufficient_capacity",
              "blocked",
              "dependency",
              "needs_clarification",
              "inactive"
            ]
          },
          "explanation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S"
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000,
        "pattern": "\\S"
      },
      "maxItems": 20
    }
  }
}
