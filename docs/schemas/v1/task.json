{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://calendar-app.local/schemas/v1/task.json",
  "title": "Calendar task v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "description",
    "status",
    "evidenceIds",
    "importance",
    "deadline",
    "estimateId",
    "dependsOn",
    "clarificationQuestions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "\\S"
    },
    "description": {
      "type": "string",
      "maxLength": 4000
    },
    "status": {
      "enum": [
        "open",
        "in_progress",
        "blocked",
        "completed",
        "cancelled"
      ]
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "\\S"
      },
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true
    },
    "importance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "basis",
        "reason",
        "evidenceIds"
      ],
      "properties": {
        "level": {
          "enum": [
            "unknown",
            "low",
            "medium",
            "high"
          ]
        },
        "basis": {
          "enum": [
            "unknown",
            "inferred",
            "user",
            "commitment"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "\\S"
          },
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": true
        }
      }
    },
    "deadline": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "at",
            "kind",
            "evidenceIds"
          ],
          "properties": {
            "at": {
              "type": "string",
              "format": "instant"
            },
            "kind": {
              "enum": [
                "hard",
                "target"
              ]
            },
            "evidenceIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "\\S"
              },
              "minItems": 1,
              "maxItems": 100,
              "uniqueItems": true
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "estimateId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "dependsOn": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "\\S"
      },
      "minItems": 0,
      "maxItems": 100,
      "uniqueItems": true
    },
    "clarificationQuestions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000,
        "pattern": "\\S"
      },
      "maxItems": 20
    }
  }
}
