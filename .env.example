PORT=4010
# Generate with pnpm setup:env. Never use a VITE_ variable for credentials.
LOCAL_API_TOKEN=
# Optional absolute SQLite path (defaults to server/data/calendar.sqlite).
# CALENDAR_DB_PATH=
# GLM-4-Flash is the default. Use local to keep analysis offline.
AI_PROVIDER=glm
GLM_API_KEY=
GLM_MODEL=glm-4-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Optional integrations: configure locally, then restart. Never commit credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generated by setup:env; keep this key with encrypted database backups.
INTEGRATION_ENCRYPTION_KEY=
BRAVE_SEARCH_API_KEY=
# Optional local Ollama embedding model (install/pull separately).
OLLAMA_EMBED_MODEL=nomic-embed-text
